# Copy to .env and fill in your values.  Never commit .env.

CMC_API_KEY=your_coinmarketcap_pro_api_key

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Public Arbitrum RPC (free, rate-limited) — replace with Alchemy/Infura for prod
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Uncomment to skip DB write (useful for local tests)
# DRY_RUN=true
